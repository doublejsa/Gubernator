# Production .env for the Docker deployment. Copy to .env on the server and fill in.
# NEVER commit this. chmod 600.

GUBERNATOR_ENV=production
APP_BASE_URL=https://app.gubernator.co

# ── Postgres (the db service) ──────────────────────────────────────────────────
POSTGRES_DB=gubernator
POSTGRES_USER=gubernator
POSTGRES_PASSWORD=CHANGE-ME-strong-random
# Note the host is the compose service name "db", not localhost:
DATABASE_URL=postgresql+asyncpg://gubernator:CHANGE-ME-strong-random@db:5432/gubernator

# ── Secrets — generate each with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE-ME
VAULT_MASTER_KEY=CHANGE-ME
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Email (Resend) ─────────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxx
EMAIL_FROM=Gubernator <noreply@gubernator.co>

# ── PayPal (LIVE for production) ───────────────────────────────────────────────
PAYPAL_ENV=live
PAYPAL_CLIENT_ID=your-live-client-id
PAYPAL_SECRET=your-live-secret
PAYPAL_PLAN_ID=                # create with: python setup_paypal_plan.py  (after live keys are set)
PAYPAL_WEBHOOK_ID=            # from the PayPal dashboard webhook you create at app.gubernator.co/api/webhook/paypal

# ── Backups (optional, Backblaze B2 / S3-compatible) ──────────────────────────
# B2_BUCKET=gubernator-backups
# B2_KEY_ID=
# B2_APP_KEY=
