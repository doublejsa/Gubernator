# Copy to .env and fill in values. NEVER commit .env.

# Environment: "dev" or "production". In production the app refuses to start
# with weak/missing secrets and serves Secure (HTTPS-only) cookies.
GUBERNATOR_ENV=dev

# PostgreSQL (needs the pgvector extension — use the pgvector/pgvector image)
DATABASE_URL=postgresql+asyncpg://gubernator:gubernator@localhost:5432/gubernator

# Auth — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# COOKIE_SECURE defaults to 1 in production, 0 otherwise. Override if needed.
# COOKIE_SECURE=1

# Vault master key — generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Protect this above all else; see SECURITY.md. Rotate via rotate_master_key.py.
VAULT_MASTER_KEY=change-me
# Set ONLY during a key rotation (the previous key), then remove afterwards.
# VAULT_MASTER_KEY_OLD=

# Email (SMTP) — transactional mail for verification + password reset
SMTP_HOST=mail.yourdomain.com
SMTP_PORT=465
SMTP_USER=noreply@yourdomain.com
SMTP_PASS=change-me
SMTP_FROM=Gubernator <noreply@yourdomain.com>
APP_BASE_URL=http://localhost:8000

# Anthropic API keys are per-user (stored in the vault) — no server-level key.
